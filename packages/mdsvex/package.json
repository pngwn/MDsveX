{
	"name": "mdsvex",
	"version": "1.0.0-next.2",
	"description": "Markdown preprocessor for Svelte",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"default": "./dist/main.js"
		},
		"./compile": {
			"types": "./dist/compile.d.ts",
			"default": "./dist/compile.js"
		},
		"./highlight": {
			"types": "./dist/highlight.d.ts",
			"default": "./dist/highlight.js"
		},
		"./highlight/languages": {
			"types": "./dist/highlight_languages.d.ts",
			"default": "./dist/highlight_languages.js"
		},
		"./package.json": "./package.json",
		"./globals": {
			"types": "./globals.d.ts"
		}
	},
	"main": "dist/main.js",
	"module": "dist/main.js",
	"types": "./dist/main.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git"
	},
	"scripts": {
		"build": "run-s build:tsc build:vite build:copy-dts",
		"build:tsc": "tsc",
		"build:vite": "vite build --config vite.config.build.ts",
		"build:copy-dts": "shx cp tsc/*.d.ts dist/",
		"test": "vitest . **/*.spec.ts"
	},
	"files": [
		"dist/*",
		"globals.d.ts"
	],
	"keywords": [
		"test",
		"preprocessor",
		"mdx",
		"markdown",
		"svelte"
	],
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"dependencies": {
		"@ampproject/remapping": "^2.3.0",
		"@mdsvex/parse": "workspace:*",
		"@mdsvex/render": "workspace:*",
		"@twinkleplop/annotation": "^0.1.7",
		"@twinkleplop/bash": "^0.1.7",
		"@twinkleplop/c": "^0.2.1",
		"@twinkleplop/core": "^0.3.1",
		"@twinkleplop/cpp": "^0.2.1",
		"@twinkleplop/css": "^0.1.7",
		"@twinkleplop/diff": "^0.1.7",
		"@twinkleplop/dockerfile": "^0.2.1",
		"@twinkleplop/dotenv": "^0.1.7",
		"@twinkleplop/go": "^0.1.7",
		"@twinkleplop/graphql": "^0.2.1",
		"@twinkleplop/html": "^0.1.7",
		"@twinkleplop/http": "^0.1.7",
		"@twinkleplop/ini": "^0.1.7",
		"@twinkleplop/javascript": "^0.1.7",
		"@twinkleplop/json": "^0.1.7",
		"@twinkleplop/jsonc": "^0.1.4",
		"@twinkleplop/markdown": "^0.2.1",
		"@twinkleplop/markdown-core": "^0.2.1",
		"@twinkleplop/powershell": "^0.2.1",
		"@twinkleplop/python": "^0.1.7",
		"@twinkleplop/rust": "^0.1.7",
		"@twinkleplop/shellsession": "^0.1.7",
		"@twinkleplop/sql": "^0.1.7",
		"@twinkleplop/svelte": "^0.1.7",
		"@twinkleplop/toml": "^0.1.7",
		"@twinkleplop/tsx": "^0.1.7",
		"@twinkleplop/typescript": "^0.1.7",
		"@twinkleplop/yaml": "^0.1.7",
		"es-module-lexer": "^1.6.0"
	},
	"peerDependencies": {
		"vite": ">=6.0.0",
		"@twinkleplop/twoslash": "^0.3.1",
		"@twinkleplop/twoslash-svelte": "^0.3.1"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		},
		"@twinkleplop/twoslash": {
			"optional": true
		},
		"@twinkleplop/twoslash-svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@twinkleplop/twoslash": "^0.3.1",
		"@twinkleplop/twoslash-svelte": "^0.3.1",
		"npm-run-all2": "^7.0.2",
		"shx": "^0.3.4",
		"svelte": "^5.55.0",
		"vite": "^7.3.1"
	}
}
