{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024", "dom", "dom.iterable", "webworker"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"isolatedModules": true,
		"types": ["vite/client"]
	},
	"include": ["src/**/*", "test/**/*"]
}
