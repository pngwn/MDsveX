{
	"name": "@mdsvex/render",
	"version": "1.0.0-next.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "packages/render"
	},
	"description": "Renderers for the PFM parser wire format",
	"type": "module",
	"scripts": {
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run --silent",
		"build": "vite build --config vite.config.build.ts && tsc --rootDir src --declaration --emitDeclarationOnly --outDir dist"
	},
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./html-cursor": {
			"types": "./dist/html_cursor.d.ts",
			"import": "./dist/html_cursor.js"
		},
		"./component": {
			"types": "./dist/component.d.ts",
			"import": "./dist/component.js"
		},
		"./mappings": {
			"types": "./dist/mappings.d.ts",
			"import": "./dist/mappings.js"
		},
		"./sourcemap": {
			"types": "./dist/sourcemap.d.ts",
			"import": "./dist/sourcemap.js"
		},
		"./stream": {
			"types": "./dist/stream.d.ts",
			"import": "./dist/stream.js"
		},
		"./Node.svelte": {
			"types": "./src/Node.svelte",
			"svelte": "./src/Node.svelte",
			"import": "./src/Node.svelte"
		}
	},
	"peerDependencies": {
		"svelte": "^5.7.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@mdsvex/parse": "workspace:*"
	},
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT"
}
