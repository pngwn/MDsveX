{
	"include": ["src/**/*"],

	"compilerOptions": {
		"rootDir": "src",
		"declaration": true,
		"target": "es2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"strict": true,
		"types": ["node"],
		"outDir": "tsc"
	}
}
