root
  html_comment " https://eugenkiss.github.io/7guis/tasks#timer "
  line_break
  line_break
  html tag="script"
  line_break
  line_break
  html tag="label"
    line_break
    text "elapsed time:"
    soft_break
    text "	"
    html tag="progress" value="{elapsed / duration}"
    line_break
  line_break
  line_break
  html tag="div"
    mustache "(elapsed / 1000).toFixed(1)"
    text "s"
  line_break
  line_break
  html tag="label"
    line_break
    text "duration:"
    soft_break
    text "	"
    html tag="input" type="range" bind:value=[object Object] min="1" max="20000" self_closing=true
    line_break
  line_break
  line_break
  html tag="button" on:click="{() => elapsed = 0}"
    text "reset"