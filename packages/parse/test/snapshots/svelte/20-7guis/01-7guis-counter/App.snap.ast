root
  html tag="script"
  line_break
  line_break
  html_comment " https://github.com/eugenkiss/7guis/wiki#counter "
  line_break
  html tag="input" type="number" bind:value=[object Object] self_closing=true
  line_break
  html tag="button" on:click="{() => count += 1}"
    paragraph
      text "count"