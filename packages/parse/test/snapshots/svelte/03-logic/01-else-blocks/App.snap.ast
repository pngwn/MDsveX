root
  html tag="script"
  line_break
  line_break
  svelte_block tag="if"
    svelte_branch tag="if" "user.loggedIn"
      line_break
      html tag="button" on:click=[object Object]
        line_break
        text "Log out"
        line_break
      line_break
    svelte_branch tag="else"
      line_break
      html tag="button" on:click=[object Object]
        line_break
        text "Log in"
        line_break
      line_break