root
  html tag="script"
  line_break
  line_break
  html tag="h1"
    paragraph
      text "The Famous Cats of YouTube"
  line_break
  line_break
  html tag="ul"
    line_break
    svelte_block tag="each"
      svelte_branch tag="each" "cats as { id, name }, i"
        line_break
        html tag="li"
          html tag="a" target="_blank" href="https://www.youtube.com/watch?v={id}"
            line_break
            paragraph
              mustache "i + 1"
              text ": "
              mustache "name"
              soft_break
              text "		"
        line_break
    line_break