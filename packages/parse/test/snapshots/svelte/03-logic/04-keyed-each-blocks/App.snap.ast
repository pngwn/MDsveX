root
  html tag="script"
  line_break
  line_break
  html tag="button" on:click=[object Object]
    line_break
    text "Remove first thing"
    line_break
  line_break
  line_break
  html tag="div" style="display: grid; grid-template-columns: 1fr 1fr; grip-gap: 1em"
    line_break
    html tag="div"
      line_break
      html tag="h2"
        text "Keyed"
      line_break
      svelte_block tag="each"
        svelte_branch tag="each" "things as thing (thing.id)"
          line_break
          html tag="Thing" current=[object Object] self_closing=true
          line_break
      line_break
    line_break
    line_break
    html tag="div"
      line_break
      html tag="h2"
        text "Unkeyed"
      line_break
      svelte_block tag="each"
        svelte_branch tag="each" "things as thing"
          line_break
          html tag="Thing" current=[object Object] self_closing=true
          line_break
      line_break
    line_break