root
  html tag="script"
  line_break
  line_break
  html tag="button" on:click=[object Object]
    line_break
    text "Count: "
    mustache "count"
    line_break
  line_break
  line_break
  html tag="p"
    mustache "count"
    text " "
    text "* 2 = "
    mustache "doubled"
  line_break
  html tag="p"
    mustache "doubled"
    text " "
    text "* 2 = "
    mustache "quadrupled"