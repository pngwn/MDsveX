root
  html tag="script"
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="checkbox" bind:checked=[object Object] self_closing=true
    soft_break
    text "	visible"
    line_break
  line_break
  line_break
  svelte_block tag="if"
    svelte_branch tag="if" "visible"
      line_break
      html tag="p" in:fly="{{ y: 200, duration: 2000 }}" out:fade=true
        line_break
        text "Flies in, fades out"
        line_break
      line_break