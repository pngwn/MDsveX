root
  html tag="script"
  line_break
  line_break
  html tag="h2"
    paragraph
      text "Arctic sea ice minimum"
  line_break
  line_break
  html tag="div" class="chart" bind:clientWidth=[object Object] bind:clientHeight=[object Object]
    line_break
    html tag="svg"
      line_break
      html_comment " y axis "
      line_break
      html tag="g" class="axis y-axis" transform="translate(0, {padding.top})"
        line_break
        svelte_block tag="each"
          svelte_branch tag="each" "yTicks as tick"
            line_break
            html tag="g" class="tick tick-{tick}" transform="translate(0, {yScale(tick) - padding.bottom})"
              line_break
              html tag="line" x2="100%"
              line_break
              html tag="text" y="-4"
                paragraph
                  mustache "tick"
                  text " "
                  mustache "tick === 8 ? ' million sq km' : ''"
              line_break
            line_break
        line_break
      line_break
      line_break
      html_comment " x axis "
      line_break
      html tag="g" class="axis x-axis"
        line_break
        svelte_block tag="each"
          svelte_branch tag="each" "xTicks as tick"
            line_break
            html tag="g" class="tick tick-{ tick }" transform="translate({xScale(tick)},{height})"
              line_break
              html tag="line" y1="-{height}" y2="-{padding.bottom}" x1="0" x2="0"
              line_break
              html tag="text" y="-2"
                paragraph
                  mustache "width > 380 ? tick : formatMobile(tick)"
              line_break
            line_break
        line_break
      line_break
      line_break
      html_comment " data "
      line_break
      html tag="path" class="path-area" d=[object Object]
      line_break
      html tag="path" class="path-line" d=[object Object]
      line_break
    line_break
  line_break
  line_break
  html tag="p"
    paragraph
      text "Average September extent. Source: "
      html tag="a" href="https://climate.nasa.gov/vital-signs/arctic-sea-ice/"
        text "NSIDC/NASA"
  line_break
  line_break
  html tag="style"
  line_break