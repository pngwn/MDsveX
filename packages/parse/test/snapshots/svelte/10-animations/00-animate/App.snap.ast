root
  html tag="script"
  line_break
  line_break
  html tag="style"
  line_break
  line_break
  html tag="div" class="board"
    line_break
    html tag="input" class="new-todo" placeholder="what needs to be done?" on:keydown="{event => event.which === 13 && add(event.target)}" self_closing=true
    line_break
    line_break
    html tag="div" class="left"
      line_break
      html tag="h2"
        text "todo"
      line_break
      svelte_block tag="each"
        svelte_branch tag="each" "todos.filter(t => !t.done) as todo (todo.id)"
          line_break
          html tag="label" in:receive="{{key: todo.id}}" out:send="{{key: todo.id}}" animate:flip=true
            line_break
            html tag="input" type="checkbox" bind:checked=[object Object] self_closing=true
            soft_break
            text "				"
            mustache "todo.description"
            soft_break
            text "				"
            html tag="button" on:click="{() => remove(todo)}"
              text "x"
            line_break
          line_break
      line_break
    line_break
    line_break
    html tag="div" class="right"
      line_break
      html tag="h2"
        text "done"
      line_break
      svelte_block tag="each"
        svelte_branch tag="each" "todos.filter(t => t.done) as todo (todo.id)"
          line_break
          html tag="label" in:receive="{{key: todo.id}}" out:send="{{key: todo.id}}" animate:flip=true
            line_break
            html tag="input" type="checkbox" bind:checked=[object Object] self_closing=true
            soft_break
            text "				"
            mustache "todo.description"
            soft_break
            text "				"
            html tag="button" on:click="{() => remove(todo)}"
              text "x"
            line_break
          line_break
      line_break
    line_break
  line_break