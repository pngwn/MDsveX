root
  html tag="script"
  line_break
  line_break
  html tag="style"
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="checkbox" bind:checked=[object Object] self_closing=true
    soft_break
    text "	big"
    line_break
  line_break
  line_break
  html tag="div" class:big=true
    line_break
    paragraph
      text "some "
      mustache "big ? 'big' : 'small'"
      text " text"
    line_break