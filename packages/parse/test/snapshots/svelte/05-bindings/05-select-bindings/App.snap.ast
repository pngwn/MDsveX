root
  html tag="script"
  line_break
  line_break
  html tag="style"
  line_break
  line_break
  html tag="h2"
    paragraph
      text "Insecurity questions"
  line_break
  line_break
  html tag="form" on:submit|preventDefault=[object Object]
    line_break
    html tag="select" bind:value=[object Object] on:change="{() => answer = ''}"
      line_break
      svelte_block tag="each"
        svelte_branch tag="each" "questions as question"
          line_break
          html tag="option" value=[object Object]
            line_break
            paragraph
              mustache "question.text"
            line_break
          line_break
      line_break
    line_break
    line_break
    html tag="input" bind:value=[object Object] self_closing=true
    line_break
    line_break
    html tag="button" disabled=[object Object] type="submit"
      line_break
      paragraph
        text "Submit"
        soft_break
        text "	"
    line_break
  line_break
  line_break
  html tag="p"
    paragraph
      text "selected question "
      mustache "selected ? selected.id : '[waiting...]'"