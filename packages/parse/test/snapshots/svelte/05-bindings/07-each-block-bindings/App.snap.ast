root
  html tag="script"
  line_break
  line_break
  html tag="style"
  line_break
  line_break
  html tag="h1"
    paragraph
      text "Todos"
  line_break
  line_break
  svelte_block tag="each"
    svelte_branch tag="each" "todos as todo"
      line_break
      html tag="div" class:done=[object Object]
        line_break
        html tag="input" type="checkbox" bind:checked=[object Object] self_closing=true
        line_break
        line_break
        html tag="input" placeholder="What needs to be done?" bind:value=[object Object] self_closing=true
        line_break
      line_break
  line_break
  line_break
  html tag="p"
    paragraph
      mustache "remaining"
      text " remaining"
  line_break
  line_break
  html tag="button" on:click=[object Object]
    line_break
    paragraph
      text "Add new"
      soft_break
  line_break
  line_break
  html tag="button" on:click=[object Object]
    line_break
    paragraph
      text "Clear completed"
      soft_break
  line_break