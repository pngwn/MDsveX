root
  html tag="script"
  line_break
  line_break
  html tag="h2"
    text "Size"
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="radio" bind:group=[object Object] value=[object Object] self_closing=true
    soft_break
    text "	One scoop"
    line_break
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="radio" bind:group=[object Object] value=[object Object] self_closing=true
    soft_break
    text "	Two scoops"
    line_break
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="radio" bind:group=[object Object] value=[object Object] self_closing=true
    soft_break
    text "	Three scoops"
    line_break
  line_break
  line_break
  html tag="h2"
    text "Flavours"
  line_break
  line_break
  svelte_block tag="each"
    svelte_branch tag="each" "menu as flavour"
      line_break
      html tag="label"
        line_break
        html tag="input" type="checkbox" bind:group=[object Object] value=[object Object] self_closing=true
        soft_break
        text "		"
        mustache "flavour"
        line_break
      line_break
  line_break
  line_break
  svelte_block tag="if"
    svelte_branch tag="if" "flavours.length === 0"
      line_break
      html tag="p"
        text "Please select at least one flavour"
      line_break
    svelte_branch tag="else if" "flavours.length > scoops"
      line_break
      html tag="p"
        text "Can't order more flavours than scoops"
        text "!"
      line_break
    svelte_branch tag="else"
      line_break
      html tag="p"
        line_break
        text "You ordered "
        mustache "scoops"
        text " "
        mustache "scoops === 1 ? 'scoop' : 'scoops'"
        soft_break
        text "		of "
        mustache "join(flavours)"
        line_break
      line_break
  line_break