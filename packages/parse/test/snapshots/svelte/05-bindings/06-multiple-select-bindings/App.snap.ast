root
  html tag="script"
  line_break
  line_break
  html tag="h2"
    paragraph
      text "Size"
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="radio" bind:group=[object Object] value=[object Object] self_closing=true
    line_break
    paragraph
      text "One scoop"
      soft_break
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="radio" bind:group=[object Object] value=[object Object] self_closing=true
    line_break
    paragraph
      text "Two scoops"
      soft_break
  line_break
  line_break
  html tag="label"
    line_break
    html tag="input" type="radio" bind:group=[object Object] value=[object Object] self_closing=true
    line_break
    paragraph
      text "Three scoops"
      soft_break
  line_break
  line_break
  html tag="h2"
    paragraph
      text "Flavours"
  line_break
  line_break
  html tag="select" multiple=true bind:value=[object Object]
    line_break
    svelte_block tag="each"
      svelte_branch tag="each" "menu as flavour"
        line_break
        html tag="option" value=[object Object]
          line_break
          paragraph
            mustache "flavour"
            soft_break
            text "		"
        line_break
    line_break
  line_break
  line_break
  svelte_block tag="if"
    svelte_branch tag="if" "flavours.length === 0"
      line_break
      html tag="p"
        paragraph
          text "Please select at least one flavour"
      line_break
    svelte_branch tag="else if" "flavours.length > scoops"
      line_break
      html tag="p"
        paragraph
          text "Can't order more flavours than scoops"
          text "!"
      line_break
    svelte_branch tag="else"
      line_break
      html tag="p"
        line_break
        paragraph
          text "You ordered "
          mustache "scoops"
          text " "
          mustache "scoops === 1 ? 'scoop' : 'scoops'"
          soft_break
          text "		of "
          mustache "join(flavours)"
          soft_break
          text "	"
      line_break
  line_break