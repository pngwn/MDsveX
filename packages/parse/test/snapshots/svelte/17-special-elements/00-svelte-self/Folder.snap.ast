root
  html tag="script"
  line_break
  line_break
  html tag="style"
  line_break
  line_break
  html tag="span" class:expanded=true on:click=[object Object]
    paragraph
      mustache "name"
  line_break
  line_break
  svelte_block tag="if"
    svelte_branch tag="if" "expanded"
      line_break
      html tag="ul"
        line_break
        svelte_block tag="each"
          svelte_branch tag="each" "files as file"
            line_break
            html tag="li"
              line_break
              svelte_block tag="if"
                svelte_branch tag="if" "file.type === 'folder'"
                  line_break
                  html tag="svelte:self" ...file=[object Object] self_closing=true
                  line_break
                svelte_branch tag="else"
                  line_break
                  html tag="File" ...file=[object Object] self_closing=true
                  line_break
              line_break
            line_break
        line_break
      line_break