		"npm-run-all2": "^7.0.2",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.5"
	},
	"dependencies": {
		"@fontsource/source-code-pro": "^5.2.5",
		"@mdsvex/plugin-anchors": "workspace:*",
