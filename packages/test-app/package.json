	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "run-s check:sync check:run",
		"check:sync": "svelte-kit sync",
		"check:run": "svelte-check --tsconfig ./tsconfig.json",
