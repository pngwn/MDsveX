{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "mdsvex",
			"camelcase": "Mdsvex",
			"title": "mdsvex",
			"scope": "text.html.pfm",
			"file-types": ["svx", "pfm"],
			"injection-regex": "^(mdsvex|svx|pfm)$",
			"highlights": "queries/highlights.scm",
			"injections": "queries/injections.scm",
			"class-name": "TreeSitterMdsvex"
		}
	],
	"metadata": {
