{
	"name": "vscode-pfm",
	"displayName": "PFM — Penguin-Flavoured Markdown",
	"description": "Language support for PFM (Penguin-Flavoured Markdown) files",
	"version": "0.1.0-next.3",
	"publisher": "pngwn",
	"private": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:pfm"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"typescriptServerPlugins": [
			{
				"name": "@mdsvex/typescript-plugin",
				"enableForWorkspaceTypeScriptVersions": true
			}
		],
		"languages": [
			{
				"id": "pfm",
				"aliases": [
					"PFM",
					"Penguin-Flavoured Markdown"
				],
				"extensions": [
					".pfm",
					".svx"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "pfm",
				"scopeName": "text.html.pfm",
				"path": "./syntaxes/pfm.tmLanguage.json",
				"embeddedLanguages": {
					"source.js": "javascript",
					"source.ts": "typescript",
					"source.css": "css",
					"meta.embedded.block.javascript": "javascript",
					"meta.embedded.block.javascriptreact": "javascriptreact",
					"meta.embedded.block.typescript": "typescript",
					"meta.embedded.block.typescriptreact": "typescriptreact",
					"meta.embedded.block.css": "css",
					"meta.embedded.block.scss": "scss",
					"meta.embedded.block.less": "less",
					"meta.embedded.block.html": "html",
					"meta.embedded.block.json": "json",
					"meta.embedded.block.jsonc": "jsonc",
					"meta.embedded.block.jsonl": "jsonl",
					"meta.embedded.block.svelte": "svelte",
					"meta.embedded.block.vue": "vue",
					"meta.embedded.block.handlebars": "handlebars",
					"meta.embedded.block.jade": "jade",
					"meta.embedded.block.twig": "twig",
					"meta.embedded.block.python": "python",
					"meta.embedded.block.rust": "rust",
					"meta.embedded.block.go": "go",
					"meta.embedded.block.shellscript": "shellscript",
					"meta.embedded.block.powershell": "powershell",
					"meta.embedded.block.bat": "bat",
					"meta.embedded.block.yaml": "yaml",
					"meta.embedded.block.ini": "ini",
					"meta.embedded.block.xml": "xml",
					"meta.embedded.block.xsl": "xsl",
					"meta.embedded.block.sql": "sql",
					"meta.embedded.block.dockerfile": "dockerfile",
					"meta.embedded.block.makefile": "makefile",
					"meta.embedded.block.ignore": "ignore",
					"meta.embedded.block.diff": "diff",
					"meta.embedded.block.log": "log",
					"meta.embedded.block.c": "c",
					"meta.embedded.block.cpp": "cpp",
					"meta.embedded.block.csharp": "csharp",
					"meta.embedded.block.fsharp": "fsharp",
					"meta.embedded.block.java": "java",
					"meta.embedded.block.scala": "scala",
					"meta.embedded.block.groovy": "groovy",
					"meta.embedded.block.clojure": "clojure",
					"meta.embedded.block.swift": "swift",
					"meta.embedded.block.objective-c": "objective-c",
					"meta.embedded.block.dart": "dart",
					"meta.embedded.block.vb": "vb",
					"meta.embedded.block.coffeescript": "coffeescript",
					"meta.embedded.block.ruby": "ruby",
					"meta.embedded.block.php": "php",
					"meta.embedded.block.perl": "perl",
					"meta.embedded.block.raku": "raku",
					"meta.embedded.block.lua": "lua",
					"meta.embedded.block.r": "r",
					"meta.embedded.block.julia": "julia",
					"meta.embedded.block.erlang": "erlang",
					"meta.embedded.block.elixir": "elixir",
					"meta.embedded.block.abap": "abap",
					"meta.embedded.block.yang": "yang",
					"meta.embedded.block.latex": "latex",
					"meta.embedded.block.bibtex": "bibtex",
					"meta.embedded.block.restructuredtext": "restructuredtext",
					"meta.embedded.block.markdown": "markdown",
					"meta.embedded.block.mdx": "mdx",
					"meta.embedded.block.pfm": "pfm"
				}
			}
		],
		"configurationDefaults": {
			"[pfm]": {
				"editor.quickSuggestions": {
					"other": "on",
					"comments": "off",
					"strings": "on"
				}
			}
		}
	},
	"scripts": {
		"build:server": "pnpm --filter @mdsvex/language-server build",
		"build:ext": "vite build --config vite.config.build.ts",
		"build": "run-s build:syntax build:server build:ext build:mkdir build:copy-server",
		"build:mkdir": "shx mkdir -p server",
		"build:copy-server": "shx cp ../language-server/dist/server.cjs server/server.cjs",
		"build:syntax": "node --no-warnings scripts/generate-tml.ts",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run --silent",
		"package": "vsce package --no-dependencies"
	},
	"dependencies": {
		"@mdsvex/typescript-plugin": "workspace:*",
		"@volar/vscode": "^2.4.28",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"npm-run-all2": "^7.0.2",
		"shx": "^0.3.4",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	}
}
