{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "PFM",
	"scopeName": "text.html.pfm",
	"patterns": [
		{ "include": "#frontmatter" },
		{ "include": "#import-statement" },
		{ "include": "#fenced-code-block" },
		{ "include": "#script-block" },
		{ "include": "#style-block" },
		{ "include": "#svelte-block" },
		{ "include": "#svelte-tag" },
		{ "include": "#html-comment" },
		{ "include": "#heading" },
		{ "include": "#thematic-break" },
		{ "include": "#directive-block" },
		{ "include": "#footnote-definition" },
		{ "include": "#directive-close" },
		{ "include": "#link-definition" },
		{ "include": "#table-row" },
		{ "include": "#blockquote" },
		{ "include": "#list-item" },
		{ "include": "#inline" }
	],
	"repository": {
		"frontmatter": {
			"name": "meta.frontmatter.pfm",
			"begin": "\\A(---)(\\s*$)",
			"end": "^(---)(\\s*$)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.frontmatter.begin.pfm" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.frontmatter.end.pfm" }
			},
			"patterns": [{ "include": "source.yaml" }]
		},

		"import-statement": {
			"name": "meta.import.pfm",
			"match": "^(import)\\b(.*)$",
			"captures": {
				"1": { "name": "keyword.control.import.pfm" },
				"2": { "patterns": [{ "include": "source.ts" }] }
			}
		},

		"heading": {
			"name": "markup.heading.pfm",
			"match": "^(#{1,6})\\s+(.+)$",
			"captures": {
				"1": { "name": "punctuation.definition.heading.pfm" },
				"2": {
					"name": "entity.name.section.pfm",
					"patterns": [{ "include": "#inline" }]
				}
			}
		},

		"thematic-break": {
			"name": "meta.separator.pfm",
			"match": "^(---|-\\s-\\s-|\\*\\s\\*\\s\\*|\\*{3,})\\s*$"
		},

		"blockquote": {
			"name": "markup.quote.pfm",
			"begin": "^\\s*(>)",
			"end": "$",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.quote.begin.pfm" }
			},
			"patterns": [
				{ "include": "#table-row-continued" },
				{ "include": "#list-item-continued" },
				{ "include": "#inline" }
			]
		},

		"list-item": {
			"name": "markup.list.pfm",
			"match": "^\\s*([-*+]|\\d+[.)]) (?:(\\[)(?:( )|([xX]))(\\])(?=[ \\t]+\\S))?",
			"captures": {
				"1": { "name": "punctuation.definition.list.begin.pfm" },
				"2": { "name": "punctuation.definition.task.begin.pfm" },
				"3": { "name": "constant.language.task.unchecked.pfm" },
				"4": { "name": "constant.language.task.checked.pfm" },
				"5": { "name": "punctuation.definition.task.end.pfm" }
			}
		},

		"list-item-continued": {
			"comment": "a list item after the marker of a block quote",
			"name": "markup.list.pfm",
			"match": "\\G\\s*([-*+]|\\d+[.)]) (?:(\\[)(?:( )|([xX]))(\\])(?=[ \\t]+\\S))?",
			"captures": {
				"1": { "name": "punctuation.definition.list.begin.pfm" },
				"2": { "name": "punctuation.definition.task.begin.pfm" },
				"3": { "name": "constant.language.task.unchecked.pfm" },
				"4": { "name": "constant.language.task.checked.pfm" },
				"5": { "name": "punctuation.definition.task.end.pfm" }
			}
		},

		"table-row": {
			"comment": "a row that starts with a pipe, after any list marker",
			"name": "markup.table.row.pfm",
			"begin": "^[ \\t]*(?:(?:[-*+]|\\d+[.)])[ \\t]+)?(?=\\|)",
			"end": "$",
			"patterns": [{ "include": "#table-cells" }]
		},

		"table-row-continued": {
			"comment": "a row after the marker of a block quote",
			"name": "markup.table.row.pfm",
			"begin": "\\G[ \\t]*(?=\\|)",
			"end": "$",
			"patterns": [{ "include": "#table-cells" }]
		},

		"table-cells": {
			"patterns": [
				{
					"comment": "a cell of the delimiter row",
					"match": "(?<=\\|)[ \\t]*(:?-+:?)[ \\t]*(?=\\||$)",
					"captures": {
						"1": { "name": "punctuation.definition.table.delimiter.pfm" }
					}
				},
				{
					"comment": "a cell that merges into the one to its left or above",
					"match": "(?<=\\|)[ \\t]*(>|\\^)[ \\t]*(?=\\||$)",
					"captures": {
						"1": { "name": "keyword.operator.table.merge.pfm" }
					}
				},
				{
					"match": "\\\\\\|",
					"name": "constant.character.escape.pfm"
				},
				{
					"match": "\\|\\|",
					"name": "punctuation.separator.table.header.pfm"
				},
				{
					"match": "\\|",
					"name": "punctuation.separator.table.cell.pfm"
				},
				{ "include": "#inline" }
			]
		},

		"link-definition": {
			"name": "meta.link.reference.def.pfm",
			"match": "^[ \\t]*(?:>[ \\t]*)*(\\[)([^\\]^][^\\]]*)(\\])(:)[ \\t]*(<[^>]*>|\\S+)(?:[ \\t]+(\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?[ \\t]*$",
			"captures": {
				"1": { "name": "punctuation.definition.constant.begin.pfm" },
				"2": { "name": "constant.other.reference.link.pfm" },
				"3": { "name": "punctuation.definition.constant.end.pfm" },
				"4": { "name": "punctuation.separator.key-value.pfm" },
				"5": { "name": "markup.underline.link.pfm" },
				"6": { "name": "string.other.link.description.title.pfm" }
			}
		},

		"fenced-code-block": {
			"patterns": [
				{ "#insert": "fenced_code_block_definitions" },
				{
					"comment": "any other language, or none, the info string may start with its meta",
					"name": "markup.fenced_code.block.pfm",
					"begin": "^([ \\t]*(?:>[ \\t]*)*)(`{3,})((?:[^\\s`=\\[{/]+(?=[ \\t]|$))?)([^`]*)$",
					"end": "^[ \\t]*(?:>[ \\t]*)*(\\2`*)[ \\t]*$",
					"beginCaptures": {
						"2": { "name": "punctuation.definition.code.begin.pfm" },
						"3": { "name": "fenced_code.block.language.pfm" },
						"4": { "patterns": [{ "include": "#fence-meta" }] }
					},
					"endCaptures": {
						"1": { "name": "punctuation.definition.code.end.pfm" }
					}
				}
			]
		},

		"fence-meta": {
			"comment": "what follows the language of a fence, each part starts the meta or follows a space",
			"patterns": [
				{
					"match": "(?<![^\\s`])(src)(=)(\"[^\"]*\"|'[^']*'|[^\\s]+)",
					"captures": {
						"1": { "name": "keyword.control.import.pfm" },
						"2": { "name": "punctuation.separator.key-value.pfm" },
						"3": { "name": "markup.underline.link.pfm" }
					}
				},
				{
					"match": "(?<![^\\s`])(run)(?:(=)(client))?(?=\\s|$)",
					"captures": {
						"1": { "name": "keyword.control.run.pfm" },
						"2": { "name": "punctuation.separator.key-value.pfm" },
						"3": { "name": "constant.language.run.pfm" }
					}
				},
				{
					"match": "(?<![^\\s`])(eval|twoslash)(?=\\s|$)",
					"name": "keyword.control.flag.pfm"
				},
				{
					"match": "(?<![^\\s`])(:(?:no-)?line-numbers(?:=\\d+)?|showLineNumbers(?:\\{\\d+\\})?)(?=\\s|$)",
					"name": "keyword.other.line-numbers.pfm"
				},
				{
					"match": "(?<![^\\s`])\\{[\\d,\\s-]+\\}(?:#[\\w-]+)?",
					"name": "constant.numeric.line-range.pfm"
				},
				{
					"match": "(?<![^\\s`])/[^/\\s]+/(?:[\\d,-]+|#[\\w-]+)?",
					"name": "string.regexp.word.pfm"
				},
				{
					"match": "(?<![^\\s`])\\[[^\\]]*\\]",
					"name": "string.other.title.pfm"
				},
				{
					"match": "(?<![^\\s`])([A-Za-z_][\\w-]*)(=)(\"[^\"]*\"|'[^']*'|[^\\s]+)",
					"captures": {
						"1": { "name": "entity.other.attribute-name.pfm" },
						"2": { "name": "punctuation.separator.key-value.pfm" },
						"3": { "name": "string.quoted.fence-meta.pfm" }
					}
				},
				{
					"match": "(?<![^\\s`])[A-Za-z_][\\w-]*(?=\\s|$)",
					"name": "entity.other.attribute-name.pfm"
				}
			]
		},

		"script-block": {
			"name": "meta.script.pfm",
			"begin": "(<)(script)([^>]*)(>)",
			"end": "(</)(script)(>)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "entity.name.tag.html" },
				"3": { "patterns": [{ "include": "#tag-attributes" }] },
				"4": { "name": "punctuation.definition.tag.end.html" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "entity.name.tag.html" },
				"3": { "name": "punctuation.definition.tag.end.html" }
			},
			"contentName": "source.ts",
			"patterns": [{ "include": "source.ts" }]
		},

		"style-block": {
			"name": "meta.style.pfm",
			"begin": "(<)(style)([^>]*)(>)",
			"end": "(</)(style)(>)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "entity.name.tag.html" },
				"3": { "patterns": [{ "include": "#tag-attributes" }] },
				"4": { "name": "punctuation.definition.tag.end.html" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "entity.name.tag.html" },
				"3": { "name": "punctuation.definition.tag.end.html" }
			},
			"contentName": "source.css",
			"patterns": [{ "include": "source.css" }]
		},

		"svelte-block": {
			"name": "meta.svelte.block.pfm",
			"patterns": [
				{
					"begin": "(\\{)(#)(if|each|await|key)",
					"end": "(\\})",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.block.begin.pfm" },
						"2": { "name": "punctuation.definition.keyword.pfm" },
						"3": { "name": "keyword.control.svelte" }
					},
					"endCaptures": {
						"1": { "name": "punctuation.definition.block.end.pfm" }
					},
					"patterns": [{ "include": "source.ts" }]
				},
				{
					"begin": "(\\{)(:)(else if|else|then|catch)",
					"end": "(\\})",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.block.begin.pfm" },
						"2": { "name": "punctuation.definition.keyword.pfm" },
						"3": { "name": "keyword.control.svelte" }
					},
					"endCaptures": {
						"1": { "name": "punctuation.definition.block.end.pfm" }
					},
					"patterns": [{ "include": "source.ts" }]
				},
				{
					"match": "(\\{)(/)(if|each|await|key)(\\})",
					"captures": {
						"1": { "name": "punctuation.definition.block.begin.pfm" },
						"2": { "name": "punctuation.definition.keyword.pfm" },
						"3": { "name": "keyword.control.svelte" },
						"4": { "name": "punctuation.definition.block.end.pfm" }
					}
				}
			]
		},

		"svelte-tag": {
			"name": "meta.svelte.tag.pfm",
			"begin": "(\\{)(@)(html|debug|const|render)",
			"end": "(\\})",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.pfm" },
				"2": { "name": "punctuation.definition.keyword.pfm" },
				"3": { "name": "keyword.control.svelte" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.pfm" }
			},
			"patterns": [{ "include": "source.ts" }]
		},

		"html-comment": {
			"name": "comment.block.html",
			"begin": "<!--",
			"end": "-->",
			"captures": {
				"0": { "name": "punctuation.definition.comment.html" }
			}
		},

		"inline": {
			"patterns": [
				{ "include": "#svelte-expression" },
				{ "include": "#component-tag" },
				{ "include": "#html-tag" },
				{ "include": "#math-span" },
				{ "include": "#code-span" },
				{ "include": "#emphasis" },
				{ "include": "#strong" },
				{ "include": "#strikethrough" },
				{ "include": "#subscript" },
				{ "include": "#superscript" },
				{ "include": "#directive" },
				{ "include": "#footnote-reference" },
				{ "include": "#link" },
				{ "include": "#image" },
				{ "include": "#link-reference" },
				{ "include": "#autolink" },
				{ "include": "#hard-break" },
				{ "include": "#escape" }
			]
		},

		"svelte-expression": {
			"name": "meta.svelte.expression.pfm",
			"begin": "(\\{)",
			"end": "(\\})",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.expression.begin.pfm" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.expression.end.pfm" }
			},
			"patterns": [{ "include": "source.ts" }]
		},

		"component-tag": {
			"name": "meta.tag.component.pfm",
			"begin": "(<)([A-Z][a-zA-Z0-9]*)",
			"end": "(/?>)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "support.class.component.svelte" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.html" }
			},
			"patterns": [{ "include": "#tag-attributes" }]
		},

		"html-tag": {
			"name": "meta.tag.html.pfm",
			"begin": "(</?)(\\w[\\w-]*)",
			"end": "(/?>)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.html" },
				"2": { "name": "entity.name.tag.html" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.html" }
			},
			"patterns": [{ "include": "#tag-attributes" }]
		},

		"tag-attributes": {
			"patterns": [
				{
					"comment": "Expression attribute: prop={expr}",
					"begin": "([a-zA-Z_][a-zA-Z0-9_:-]*)(=)(\\{)",
					"end": "(\\})",
					"beginCaptures": {
						"1": { "name": "entity.other.attribute-name.html" },
						"2": { "name": "punctuation.separator.key-value.html" },
						"3": { "name": "punctuation.definition.expression.begin.pfm" }
					},
					"endCaptures": {
						"1": { "name": "punctuation.definition.expression.end.pfm" }
					},
					"patterns": [{ "include": "source.ts" }]
				},
				{
					"comment": "String attribute: prop=\"value\"",
					"match": "([a-zA-Z_][a-zA-Z0-9_:-]*)(=)(\"[^\"]*\"|'[^']*')",
					"captures": {
						"1": { "name": "entity.other.attribute-name.html" },
						"2": { "name": "punctuation.separator.key-value.html" },
						"3": { "name": "string.quoted.html" }
					}
				},
				{
					"comment": "Boolean attribute",
					"match": "([a-zA-Z_][a-zA-Z0-9_:-]*)",
					"captures": {
						"1": { "name": "entity.other.attribute-name.html" }
					}
				}
			]
		},

		"math-span": {
			"name": "markup.math.inline.pfm",
			"match": "(\\$)(`{1,2})(?!`)(.+?)(?<!`)(\\2)(?!`)(\\$)",
			"captures": {
				"1": { "name": "punctuation.definition.math.begin.pfm" },
				"2": { "name": "punctuation.definition.raw.begin.pfm" },
				"3": { "name": "meta.embedded.math.pfm markup.raw.inline.pfm" },
				"4": { "name": "punctuation.definition.raw.end.pfm" },
				"5": { "name": "punctuation.definition.math.end.pfm" }
			}
		},

		"code-span": {
			"name": "markup.inline.raw.string.pfm",
			"match": "(`+)(.+?)(\\1)",
			"captures": {
				"1": { "name": "punctuation.definition.raw.begin.pfm" },
				"2": { "name": "markup.raw.inline.pfm" },
				"3": { "name": "punctuation.definition.raw.end.pfm" }
			}
		},

		"emphasis": {
			"name": "markup.italic.pfm",
			"begin": "(?<=\\s|^)(_)(?=\\S)",
			"end": "(_)(?=\\s|$|[.,;:!?)])",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.italic.begin.pfm" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.italic.end.pfm" }
			},
			"patterns": [{ "include": "#inline" }]
		},

		"strong": {
			"name": "markup.bold.pfm",
			"begin": "(?<=\\s|^)(\\*)(?=\\S)",
			"end": "(\\*)(?=\\s|$|[.,;:!?)])",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.bold.begin.pfm" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.bold.end.pfm" }
			},
			"patterns": [{ "include": "#inline" }]
		},

		"strikethrough": {
			"name": "markup.strikethrough.pfm",
			"begin": "(~~)",
			"end": "(~~)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.strikethrough.begin.pfm" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.strikethrough.end.pfm" }
			},
			"patterns": [{ "include": "#inline" }]
		},

		"directive": {
			"name": "meta.directive.pfm",
			"match": "(?<![\\w:])(:{1,3})([A-Za-z_][\\w-]*)(\\[)((?:[^\\[\\]\\n\\\\]|\\\\.|\\[[^\\[\\]\\n]*\\])*)(\\])(?:(\\()([^)\\n]*)(\\)))?",
			"captures": {
				"1": { "name": "punctuation.definition.directive.pfm" },
				"2": { "name": "entity.name.tag.directive.pfm" },
				"3": { "name": "punctuation.definition.directive.label.begin.pfm" },
				"4": {
					"name": "meta.directive.label.pfm",
					"patterns": [{ "include": "#inline" }]
				},
				"5": { "name": "punctuation.definition.directive.label.end.pfm" },
				"6": { "name": "punctuation.definition.directive.args.begin.pfm" },
				"7": {
					"name": "meta.directive.args.pfm",
					"patterns": [{ "include": "#directive-arg" }]
				},
				"8": { "name": "punctuation.definition.directive.args.end.pfm" }
			}
		},

		"directive-block": {
			"comment": "a leaf or container directive without brackets, alone on its line after any quote and list markers",
			"match": "^([ \\t]*(?:>[ \\t]*|(?:[-*+]|\\d+[.)])[ \\t]+)*)((:{2,})([A-Za-z][\\w-]*)(?:(\\()([^)\\n]*)(\\)))?)[ \\t]*$",
			"captures": {
				"1": {
					"patterns": [
						{ "match": ">", "name": "punctuation.definition.quote.begin.pfm" },
						{
							"match": "[-*+]|\\d+[.)]",
							"name": "punctuation.definition.list.begin.pfm"
						}
					]
				},
				"2": { "name": "meta.directive.pfm" },
				"3": { "name": "punctuation.definition.directive.pfm" },
				"4": { "name": "entity.name.tag.directive.pfm" },
				"5": { "name": "punctuation.definition.directive.args.begin.pfm" },
				"6": {
					"name": "meta.directive.args.pfm",
					"patterns": [{ "include": "#directive-arg" }]
				},
				"7": { "name": "punctuation.definition.directive.args.end.pfm" }
			}
		},

		"directive-arg": {
			"patterns": [
				{
					"match": "([A-Za-z_][\\w-]*)\\s*(=)\\s*(\"[^\"]*\"|'[^']*'|[^,\\s)]*)",
					"captures": {
						"1": { "name": "entity.other.attribute-name.pfm" },
						"2": { "name": "punctuation.separator.key-value.pfm" },
						"3": { "name": "string.unquoted.directive-arg.pfm" }
					}
				},
				{ "match": ",", "name": "punctuation.separator.arguments.pfm" }
			]
		},

		"footnote-reference": {
			"name": "meta.footnote.reference.pfm",
			"match": "(?<!\\\\)(\\[\\^)([^\\s\\[\\]^]+)(\\])",
			"captures": {
				"1": { "name": "punctuation.definition.footnote.begin.pfm" },
				"2": { "name": "entity.name.footnote.pfm" },
				"3": { "name": "punctuation.definition.footnote.end.pfm" }
			}
		},

		"footnote-definition": {
			"name": "meta.footnote.definition.pfm",
			"match": "^\\s*(\\[\\^)([^\\s\\[\\]^]+)(\\]:)(?:[ \\t]+(\\S.*)|[ \\t]*)$",
			"captures": {
				"1": { "name": "punctuation.definition.footnote.begin.pfm" },
				"2": { "name": "entity.name.footnote.pfm" },
				"3": { "name": "punctuation.definition.footnote.end.pfm" },
				"4": { "patterns": [{ "include": "#inline" }] }
			}
		},

		"link": {
			"name": "meta.link.inline.pfm",
			"match": "(\\[)([^\\]]*)(\\])(\\()([^)]*)(\\))",
			"captures": {
				"1": { "name": "punctuation.definition.link.begin.pfm" },
				"2": { "name": "string.other.link.title.pfm" },
				"3": { "name": "punctuation.definition.link.end.pfm" },
				"4": { "name": "punctuation.definition.link.begin.pfm" },
				"5": { "name": "markup.underline.link.pfm" },
				"6": { "name": "punctuation.definition.link.end.pfm" }
			}
		},

		"image": {
			"name": "meta.image.inline.pfm",
			"match": "(!)\\[([^\\]]*)](\\()([^)]*)(\\))",
			"captures": {
				"1": { "name": "punctuation.definition.image.pfm" },
				"2": { "name": "string.other.link.description.pfm" },
				"3": { "name": "punctuation.definition.link.begin.pfm" },
				"4": { "name": "markup.underline.link.image.pfm" },
				"5": { "name": "punctuation.definition.link.end.pfm" }
			}
		},

		"autolink": {
			"name": "meta.link.autolink.pfm",
			"match": "(<)(https?://[^>]+)(>)",
			"captures": {
				"1": { "name": "punctuation.definition.link.begin.pfm" },
				"2": { "name": "markup.underline.link.pfm" },
				"3": { "name": "punctuation.definition.link.end.pfm" }
			}
		},

		"escape": {
			"name": "constant.character.escape.pfm",
			"match": "\\\\[\\\\`*_{}\\[\\]()#+\\-.!|~>^:<&$]"
		},

		"hard-break": {
			"name": "constant.character.escape.hard-break.pfm",
			"match": "\\\\$"
		},

		"subscript": {
			"name": "markup.subscript.pfm",
			"match": "(?<![~\\\\])(~)(?![~\\s])([^~\\n]*?[^~\\s\\\\])(~)(?!~)",
			"captures": {
				"1": { "name": "punctuation.definition.subscript.begin.pfm" },
				"3": { "name": "punctuation.definition.subscript.end.pfm" }
			}
		},

		"superscript": {
			"name": "markup.superscript.pfm",
			"match": "(?<!\\\\)(\\^)(?!\\s)([^\\^\\n]*?[^\\^\\s\\\\])(\\^)",
			"captures": {
				"1": { "name": "punctuation.definition.superscript.begin.pfm" },
				"3": { "name": "punctuation.definition.superscript.end.pfm" }
			}
		},

		"link-reference": {
			"comment": "a link or an image that names a definition",
			"name": "meta.link.reference.pfm",
			"match": "(!)?(\\[)([^\\]]*)(\\])(\\[)([^\\]]*)(\\])",
			"captures": {
				"1": { "name": "punctuation.definition.image.pfm" },
				"2": { "name": "punctuation.definition.link.begin.pfm" },
				"3": { "name": "string.other.link.title.pfm" },
				"4": { "name": "punctuation.definition.link.end.pfm" },
				"5": { "name": "punctuation.definition.constant.begin.pfm" },
				"6": { "name": "constant.other.reference.link.pfm" },
				"7": { "name": "punctuation.definition.constant.end.pfm" }
			}
		},

		"directive-close": {
			"comment": "the line of colons that closes a container directive",
			"match": "^[ \\t]*(?:>[ \\t]*)*(:{3,})[ \\t]*$",
			"captures": {
				"1": { "name": "punctuation.definition.directive.end.pfm" }
			}
		}
	}
}
