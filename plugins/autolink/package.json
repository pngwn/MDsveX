{
	"name": "@mdsvex/plugin-autolink",
	"version": "0.1.0-next.1",
	"description": "Auto-link headings with slug-based anchors",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "run-s build:tsc build:vite build:copy-dts",
		"build:tsc": "tsc",
		"build:vite": "vite build --config vite.config.build.ts",
		"build:copy-dts": "shx cp tsc/*.d.ts dist/",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/autolink"
	},
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "workspace:^"
	},
	"devDependencies": {
		"@mdsvex/parse": "workspace:*",
		"mdsvex": "workspace:*",
		"npm-run-all2": "^7.0.2",
		"shx": "^0.3.4"
	}
}
