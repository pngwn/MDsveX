{
	"name": "@mdsvex/plugin-kit",
	"version": "0.0.1",
	"description": "Components most mdsvex sites want: details, accordions, keys, ruby, badges, video embeds, figures, code blocks with a copy button and mermaid diagrams",
	"type": "module",
	"scripts": {
		"build": "run-s build:check build:package",
		"build:check": "tsc",
		"build:package": "svelte-package -i src -o dist",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./directives": {
			"types": "./dist/unstyled.d.ts",
			"svelte": "./dist/directives.js"
		},
		"./directives/unstyled": {
			"types": "./dist/unstyled.d.ts",
			"svelte": "./dist/unstyled.js"
		},
		"./Details.svelte": {
			"types": "./dist/Details.svelte.d.ts",
			"svelte": "./dist/Details.svelte"
		},
		"./Accordion.svelte": {
			"types": "./dist/Accordion.svelte.d.ts",
			"svelte": "./dist/Accordion.svelte"
		},
		"./Kbd.svelte": {
			"types": "./dist/Kbd.svelte.d.ts",
			"svelte": "./dist/Kbd.svelte"
		},
		"./Ruby.svelte": {
			"types": "./dist/Ruby.svelte.d.ts",
			"svelte": "./dist/Ruby.svelte"
		},
		"./Badge.svelte": {
			"types": "./dist/Badge.svelte.d.ts",
			"svelte": "./dist/Badge.svelte"
		},
		"./YouTube.svelte": {
			"types": "./dist/YouTube.svelte.d.ts",
			"svelte": "./dist/YouTube.svelte"
		},
		"./Vimeo.svelte": {
			"types": "./dist/Vimeo.svelte.d.ts",
			"svelte": "./dist/Vimeo.svelte"
		},
		"./figures": {
			"types": "./dist/figures-unstyled.d.ts",
			"svelte": "./dist/figures.js"
		},
		"./figures/unstyled": {
			"types": "./dist/figures-unstyled.d.ts",
			"svelte": "./dist/figures-unstyled.js"
		},
		"./Figure.svelte": {
			"types": "./dist/Figure.svelte.d.ts",
			"svelte": "./dist/Figure.svelte"
		},
		"./code-blocks": {
			"types": "./dist/code-blocks-unstyled.d.ts",
			"svelte": "./dist/code-blocks.js"
		},
		"./code-blocks/unstyled": {
			"types": "./dist/code-blocks-unstyled.d.ts",
			"svelte": "./dist/code-blocks-unstyled.js"
		},
		"./Pre.svelte": {
			"types": "./dist/Pre.svelte.d.ts",
			"svelte": "./dist/Pre.svelte"
		},
		"./mermaid": {
			"types": "./dist/mermaid-unstyled.d.ts",
			"svelte": "./dist/mermaid.js"
		},
		"./mermaid/unstyled": {
			"types": "./dist/mermaid-unstyled.d.ts",
			"svelte": "./dist/mermaid-unstyled.js"
		},
		"./Mermaid.svelte": {
			"types": "./dist/Mermaid.svelte.d.ts",
			"svelte": "./dist/Mermaid.svelte"
		},
		"./kit.css": "./dist/kit.css",
		"./figures.css": "./dist/figures.css",
		"./code-blocks.css": "./dist/code-blocks.css",
		"./mermaid.css": "./dist/mermaid.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/directives.js",
		"./dist/figures.js",
		"./dist/code-blocks.js",
		"./dist/mermaid.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/kit"
	},
	"keywords": [
		"mdsvex",
		"mdsvex-plugin",
		"svelte",
		"markdown",
		"details",
		"accordion",
		"kbd",
		"ruby",
		"badge",
		"youtube",
		"vimeo",
		"figure",
		"copy-button",
		"code-block",
		"mermaid"
	],
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "^1.0.0-next.2",
		"mermaid": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"svelte": "^5.20.0"
	},
	"peerDependenciesMeta": {
		"mermaid": {
			"optional": true
		}
	},
	"devDependencies": {
		"@mdsvex/plugin-tabs": "workspace:^",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"mdsvex": "workspace:^",
		"mermaid": "12.1.0",
		"npm-run-all2": "^7.0.2",
		"svelte": "^5.55.0",
		"vite": "^7.3.1"
	}
}
