{
	"name": "@mdsvex/plugin-elements",
	"version": "0.1.0-next.0",
	"description": "Directives over html elements for mdsvex: details, accordions, keys, ruby, badges, marks, insertions and abbreviations",
	"type": "module",
	"scripts": {
		"build": "run-s build:check build:package",
		"build:check": "tsc",
		"build:package": "svelte-package -i src -o dist",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./directives": {
			"types": "./dist/unstyled.d.ts",
			"svelte": "./dist/directives.js"
		},
		"./directives/unstyled": {
			"types": "./dist/unstyled.d.ts",
			"svelte": "./dist/unstyled.js"
		},
		"./Details.svelte": {
			"types": "./dist/Details.svelte.d.ts",
			"svelte": "./dist/Details.svelte"
		},
		"./Accordion.svelte": {
			"types": "./dist/Accordion.svelte.d.ts",
			"svelte": "./dist/Accordion.svelte"
		},
		"./Kbd.svelte": {
			"types": "./dist/Kbd.svelte.d.ts",
			"svelte": "./dist/Kbd.svelte"
		},
		"./Ruby.svelte": {
			"types": "./dist/Ruby.svelte.d.ts",
			"svelte": "./dist/Ruby.svelte"
		},
		"./Badge.svelte": {
			"types": "./dist/Badge.svelte.d.ts",
			"svelte": "./dist/Badge.svelte"
		},
		"./Mark.svelte": {
			"types": "./dist/Mark.svelte.d.ts",
			"svelte": "./dist/Mark.svelte"
		},
		"./Ins.svelte": {
			"types": "./dist/Ins.svelte.d.ts",
			"svelte": "./dist/Ins.svelte"
		},
		"./Abbr.svelte": {
			"types": "./dist/Abbr.svelte.d.ts",
			"svelte": "./dist/Abbr.svelte"
		},
		"./elements.css": "./dist/elements.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/directives.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/elements"
	},
	"keywords": [
		"mdsvex",
		"mdsvex-plugin",
		"svelte",
		"markdown",
		"details",
		"accordion",
		"kbd",
		"ruby",
		"badge",
		"mark",
		"ins",
		"abbr"
	],
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "^1.0.0-next.2",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"mdsvex": "workspace:^",
		"npm-run-all2": "^7.0.2",
		"svelte": "^5.55.0",
		"vite": "^7.3.1"
	}
}
