{
	"name": "@mdsvex/plugin-diagram",
	"version": "0.1.0-next.0",
	"description": "Diagrams for mdsvex: mermaid fences drawn at build time by pele, or in the browser by mermaid",
	"type": "module",
	"scripts": {
		"build": "run-s build:check build:package",
		"build:check": "tsc",
		"build:package": "svelte-package -i src -o dist",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./pele": {
			"types": "./dist/pele-unstyled.d.ts",
			"svelte": "./dist/pele.js"
		},
		"./pele/unstyled": {
			"types": "./dist/pele-unstyled.d.ts",
			"svelte": "./dist/pele-unstyled.js"
		},
		"./mermaid": {
			"types": "./dist/mermaid-unstyled.d.ts",
			"svelte": "./dist/mermaid.js"
		},
		"./mermaid/unstyled": {
			"types": "./dist/mermaid-unstyled.d.ts",
			"svelte": "./dist/mermaid-unstyled.js"
		},
		"./PeleDiagram.svelte": {
			"types": "./dist/PeleDiagram.svelte.d.ts",
			"svelte": "./dist/PeleDiagram.svelte"
		},
		"./MermaidDiagram.svelte": {
			"types": "./dist/MermaidDiagram.svelte.d.ts",
			"svelte": "./dist/MermaidDiagram.svelte"
		},
		"./diagram.css": "./dist/diagram.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/pele.js",
		"./dist/mermaid.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/diagram"
	},
	"keywords": [
		"mdsvex",
		"mdsvex-plugin",
		"svelte",
		"markdown",
		"diagram",
		"mermaid",
		"pele"
	],
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "^1.0.0-next.2",
		"mermaid": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"pele": "^1.9.0",
		"svelte": "^5.20.0"
	},
	"peerDependenciesMeta": {
		"mermaid": {
			"optional": true
		},
		"pele": {
			"optional": true
		}
	},
	"devDependencies": {
		"@mdsvex/plugin-tabs": "workspace:^",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.15.2",
		"mdsvex": "workspace:^",
		"mermaid": "12.1.0",
		"npm-run-all2": "^7.0.2",
		"pele": "1.9.0",
		"svelte": "^5.55.0",
		"vite": "^7.3.1"
	}
}
