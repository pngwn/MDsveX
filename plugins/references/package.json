{
	"name": "@mdsvex/plugin-references",
	"version": "0.1.0-next.0",
	"description": "References for mdsvex, links for @user, #123, owner/repo#123 and commits, and for bare urls when asked",
	"type": "module",
	"scripts": {
		"build": "run-s build:tsc build:vite build:copy-dts",
		"build:tsc": "tsc",
		"build:vite": "vite build --config vite.config.build.ts",
		"build:copy-dts": "shx cp tsc/*.d.ts dist/",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/references"
	},
	"keywords": [
		"mdsvex",
		"mdsvex-plugin",
		"markdown",
		"github",
		"mentions",
		"issues",
		"linkify",
		"autolink"
	],
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "^1.0.0-next.2"
	},
	"devDependencies": {
		"@mdsvex/plugin-anchors": "workspace:^",
		"@mdsvex/plugin-emoji": "workspace:^",
		"@mdsvex/plugin-external-links": "workspace:^",
		"mdsvex": "workspace:^",
		"npm-run-all2": "^7.0.2",
		"shx": "^0.3.4"
	}
}
