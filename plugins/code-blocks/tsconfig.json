{
	"include": ["src/**/*"],

	"compilerOptions": {
		"declaration": true,
		"target": "es2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"strict": true,
		"noEmit": true,
		"types": ["svelte", "vite/client"]
	}
}
