{
	"name": "@mdsvex/plugin-numbering",
	"version": "0.0.1",
	"description": "Numbering for mdsvex, numbered figures, tables, equations and sections, and :ref[fig:x] references that read as the number",
	"type": "module",
	"scripts": {
		"build": "run-s build:check build:package",
		"build:check": "tsc",
		"build:package": "svelte-package -i src -o dist",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./directives": {
			"types": "./dist/directives.d.ts",
			"svelte": "./dist/directives.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/numbering"
	},
	"keywords": [
		"mdsvex",
		"mdsvex-plugin",
		"svelte",
		"markdown",
		"numbering",
		"cross-references",
		"figures",
		"equations"
	],
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "^1.0.0-next.2",
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@mdsvex/parse": "workspace:*",
		"@mdsvex/render": "workspace:*",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"mdsvex": "workspace:^",
		"npm-run-all2": "^7.0.2",
		"svelte": "^5.55.0",
		"vite": "^7.3.1"
	}
}
