{
	"name": "@mdsvex/plugin-callouts",
	"version": "0.1.0",
	"description": "Callouts for mdsvex: note, tip, important, warning and caution, with a default or custom title",
	"type": "module",
	"scripts": {
		"build": "run-s build:check build:package",
		"build:check": "tsc",
		"build:package": "svelte-package -i src -o dist",
		"test": "vitest --disableConsoleIntercept",
		"test:run": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./directives": {
			"types": "./dist/unstyled.d.ts",
			"svelte": "./dist/directives.js"
		},
		"./directives/unstyled": {
			"types": "./dist/unstyled.d.ts",
			"svelte": "./dist/unstyled.js"
		},
		"./Callout.svelte": {
			"types": "./dist/Callout.static.svelte.d.ts",
			"svelte": "./dist/Callout.static.svelte"
		},
		"./callouts.css": "./dist/callouts.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/directives.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pngwn/MDsveX.git",
		"directory": "plugins/callouts"
	},
	"keywords": [
		"mdsvex",
		"mdsvex-plugin",
		"svelte",
		"markdown",
		"callout",
		"alert",
		"admonition",
		"note",
		"warning"
	],
	"mdsvex": {
		"concerns": [
			"layout"
		],
		"syntax": [
			{
				"mark": ":::note",
				"source": ":::note\nRead this first.\n:::\n"
			},
			{
				"mark": ":::warning[Title]",
				"source": ":::warning[Breaking change]\nRead this first.\n:::\n"
			}
		]
	},
	"author": "pngwn <hello@pngwn.io>",
	"license": "MIT",
	"peerDependencies": {
		"mdsvex": "^1.0.0-next.2",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"mdsvex": "workspace:^",
		"npm-run-all2": "^7.0.2",
		"svelte": "^5.55.0",
		"vite": "^7.3.1"
	}
}
